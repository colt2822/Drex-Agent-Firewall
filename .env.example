# Drex Agent Firewall Environment Configuration

# Provider Mode: "drex" or "replay" (default: replay when DREX_API_KEY is not set)
DREX_PROVIDER_TYPE=replay

# Drex Live API Configuration (required if DREX_PROVIDER_TYPE=drex)
DREX_API_URL=https://drex.nace.ai
DREX_API_KEY=your_drex_api_key_here
DREX_REQUESTED_MODEL=drex-latest
DREX_TIMEOUT_SECONDS=5.0

# Server Configuration
DREX_FIREWALL_HOST=0.0.0.0
DREX_FIREWALL_PORT=8000
DREX_DATABASE_PATH=drex_firewall.db

# Log & Audit Level
DREX_LOG_LEVEL=INFO
